# Runnable examples default to PAT. Set sa explicitly to use SA Key or SAT.
QODER_AUTH_MODE=pat
# For SA examples, selects the business and exchange hosts together.
QODER_SA_REGION=cn

# Separate test accounts are supported. Do not commit real PATs.
QODER_FORWARD_PAT=
QODER_FORWARD_BASE_URL=https://api.qoder.com.cn/api/v1/forward
QODER_FORWARD_MODEL=

QODER_MANAGED_PAT=
QODER_MANAGED_BASE_URL=https://api.qoder.com.cn/api/v1/cloud
QODER_MANAGED_MODEL=

# Optional fallback for either mode.
QODER_PAT=

# pytest live tests require explicit opt-in in the process environment:
# QODER_RUN_LIVE=1 python -m pytest examples -m live -v
# Scenarios other than models create resources and may consume model credits.

# Separate SA tests run CN and Global; they load this file or process variables.
# QODER_AUTH_MODE selects examples only; ordinary PAT suites stay PAT.
# Never commit real keys.
# Ordinary clients do not read these implicitly.
QODER_SA_CN_KEY=
QODER_SA_GLOBAL_KEY=
# Separate SA execution entry; set both flags only for dedicated test accounts.
QODER_SA_LIVE_ALLOW_WRITE=false
QODER_SA_LIVE_ALLOW_EXECUTION=false
QODER_SA_MODEL=auto
# Optional single-region factory input (QODER_SA_KEY), used only explicitly.
QODER_SA_KEY=
QODER_ACCESS_TOKEN=

# Realtime opt-in tests create persistent Conversations and temporary Identities.
# Both regions and PAT/SA templates are preflighted before the first request.
QODER_REALTIME_LIVE_ALLOW_WRITE=false
QODER_REALTIME_LIVE_ALLOW_EXECUTION=false
QODER_REALTIME_CN_PAT_TEMPLATE_ID=
QODER_REALTIME_CN_SA_TEMPLATE_ID=
QODER_REALTIME_GLOBAL_PAT_TEMPLATE_ID=
QODER_REALTIME_GLOBAL_SA_TEMPLATE_ID=
QODER_FORWARD_CN_PAT=
QODER_FORWARD_GLOBAL_PAT=
# SA requires Forward-issued, bound SATs for Realtime. Never falls back to PAT.
QODER_REALTIME_CN_SAT=
QODER_REALTIME_GLOBAL_SAT=
# When absent, the platform QODER_SA_*_KEY path remains available for diagnostics.
# ServiceAccountCredential does not automatically create a Forward token binding.
# Optional raw PCM16 input (16 kHz mono little-endian); otherwise sends short text.
# QODER_REALTIME_CN_PCM_FILE=
# QODER_REALTIME_GLOBAL_PCM_FILE=

# Forward Drive Beta lifecycle (creates isolated Identities; no model execution).
# Uses QODER_FORWARD_CN_PAT, QODER_FORWARD_GLOBAL_PAT, QODER_SA_CN_KEY,
# and QODER_SA_GLOBAL_KEY. Never point clear at a shared Identity.
QODER_DRIVE_LIVE_ALLOW_WRITE=false

# Forward Decisions consume model usage and retain records until server expiry.
# Also requires QODER_FORWARD_LIVE_ALLOW_WRITE/EXECUTION=true.
QODER_FORWARD_LIVE_ALLOW_DECISIONS=false
# Optional existing Session for the Python/TypeScript live suite and all examples.
QODER_DECISION_SESSION_ID=
